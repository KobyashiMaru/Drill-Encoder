<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Central High-Intensity Core (White Hot) -->
    <path
        android:pathData="M100,100 m-25,0 a25,25 0 1,1 50,0 a25,25 0 1,1 -50,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="25"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.6" android:color="#AAFFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mid-Layer Glow (Cyan/Blue Soft) -->
    <path
        android:pathData="M100,100 m-60,0 a60,60 0 1,1 120,0 a60,60 0 1,1 -120,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="60"
                android:type="radial">
                <item android:offset="0.0" android:color="#60AACCFF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Atmosphere (Very faint Blue) -->
    <path
        android:pathData="M100,100 m-95,0 a95,95 0 1,1 190,0 a95,95 0 1,1 -190,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="90"
                android:type="radial">
                <item android:offset="0.4" android:color="#100088FF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
